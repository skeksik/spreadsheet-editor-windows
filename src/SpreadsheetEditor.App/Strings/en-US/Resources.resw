<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's user-visible strings (CLAUDE.md, docs/notes/localisation.md). Every key is in both Strings/en-US and Strings/ru-RU.
  Keys with a dot are set by x:Uid on a XAML element (Name.Property); keys without one are read in code through Services/Strings.
-->
<root>
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <data name="AppDisplayName" xml:space="preserve">
    <value>Spreadsheet Editor</value>
    <comment>The product name. Not translated (spec §7.2): the same in every language.</comment>
  </data>
  <data name="WindowTitleWithFile" xml:space="preserve">
    <value>{0} - Spreadsheet Editor</value>
    <comment>The window title with a document open (spec §10.8). {0} is the file name. The product name is not translated.</comment>
  </data>
  <data name="LanguageName_English" xml:space="preserve">
    <value>English</value>
    <comment>The language's name in its own language (spec §10.9). Not translated.</comment>
  </data>
  <data name="LanguageName_Russian" xml:space="preserve">
    <value>Русский</value>
    <comment>The language's name in its own language (spec §10.9). Not translated.</comment>
  </data>
  <data name="MainWindow_FileMenu.Title" xml:space="preserve">
    <value>File</value>
    <comment>The File menu.</comment>
  </data>
  <data name="MainWindow_ExitItem.Text" xml:space="preserve">
    <value>Exit</value>
    <comment>File menu: closes the window.</comment>
  </data>
  <data name="MainWindow_EmptyTitle.Text" xml:space="preserve">
    <value>No spreadsheet open</value>
    <comment>Shown while no spreadsheet is open.</comment>
  </data>
  <data name="MainWindow_EmptyHint.Text" xml:space="preserve">
    <value>Open an .xlsx or .csv file to edit its rows as cards.</value>
    <comment>Shown under MainWindow_EmptyTitle.</comment>
  </data>
  <data name="MainWindow_FileMenu.AccessKey" xml:space="preserve">
    <value>F</value>
    <comment>Access key of the File menu (Alt+key).</comment>
  </data>
  <data name="MainWindow_NewItem.Text" xml:space="preserve">
    <value>New</value>
    <comment>File menu: a new, empty spreadsheet (Ctrl+N).</comment>
  </data>
  <data name="MainWindow_NewItem.AccessKey" xml:space="preserve">
    <value>N</value>
    <comment>Access key of File › New.</comment>
  </data>
  <data name="MainWindow_OpenItem.Text" xml:space="preserve">
    <value>Open</value>
    <comment>File menu: opens a .xlsx or .csv file (Ctrl+O).</comment>
  </data>
  <data name="MainWindow_OpenItem.AccessKey" xml:space="preserve">
    <value>O</value>
    <comment>Access key of File › Open.</comment>
  </data>
  <data name="MainWindow_SaveItem.Text" xml:space="preserve">
    <value>Save</value>
    <comment>File menu: saves to the current file (Ctrl+S).</comment>
  </data>
  <data name="MainWindow_SaveItem.AccessKey" xml:space="preserve">
    <value>S</value>
    <comment>Access key of File › Save.</comment>
  </data>
  <data name="MainWindow_SaveAsItem.Text" xml:space="preserve">
    <value>Save as</value>
    <comment>File menu: saves to a file the user chooses (Ctrl+Shift+S).</comment>
  </data>
  <data name="MainWindow_SaveAsItem.AccessKey" xml:space="preserve">
    <value>A</value>
    <comment>Access key of File › Save as.</comment>
  </data>
  <data name="MainWindow_ExitItem.AccessKey" xml:space="preserve">
    <value>X</value>
    <comment>Access key of File › Exit.</comment>
  </data>
  <data name="MainWindow_BusyBar.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Opening or saving the file</value>
    <comment>The screen reader name of the progress bar shown while a file is opened or saved.</comment>
  </data>
  <data name="UntitledName" xml:space="preserve">
    <value>Untitled</value>
    <comment>The name of a new document that was never saved, in the title and the save question.</comment>
  </data>
  <data name="NewSheetBaseName" xml:space="preserve">
    <value>Sheet</value>
    <comment>The name of the sheet in a new document, followed by a number (Sheet1). Must be a valid Excel sheet name.</comment>
  </data>
  <data name="SheetSummary" xml:space="preserve">
    <value>{0} — cards: {1}</value>
    <comment>Placeholder line for an open sheet until the card view exists. {0} is the sheet name, {1} the number of cards.</comment>
  </data>
  <data name="NoSheetsSummary" xml:space="preserve">
    <value>This file has no sheet with a table.</value>
    <comment>Placeholder shown for an open file without any sheet that holds a table.</comment>
  </data>
  <data name="SaveChangesQuestion" xml:space="preserve">
    <value>Do you want to save changes to {0}?</value>
    <comment>Title of the unsaved-changes question (spec §10.4). {0} is the file name.</comment>
  </data>
  <data name="SaveChangesSave" xml:space="preserve">
    <value>Save</value>
    <comment>Unsaved-changes question: the primary button, saves first.</comment>
  </data>
  <data name="SaveChangesDontSave" xml:space="preserve">
    <value>Don't save</value>
    <comment>Unsaved-changes question: goes on without saving.</comment>
  </data>
  <data name="SaveChangesCancel" xml:space="preserve">
    <value>Cancel</value>
    <comment>Unsaved-changes question: cancels the action.</comment>
  </data>
  <data name="OpenFailedTitle" xml:space="preserve">
    <value>Couldn't open {0}</value>
    <comment>Title of the error shown when a file cannot be opened. {0} is the file name.</comment>
  </data>
  <data name="SaveFailedTitle" xml:space="preserve">
    <value>Couldn't save {0}</value>
    <comment>Title of the error shown when a file cannot be saved. {0} is the file name.</comment>
  </data>
  <data name="ErrorDetailsHeader" xml:space="preserve">
    <value>Details</value>
    <comment>Header of the expander that holds the technical error message.</comment>
  </data>
  <data name="ErrorDialogClose" xml:space="preserve">
    <value>OK</value>
    <comment>The button that closes an error message.</comment>
  </data>
  <data name="SaveTypeXlsx" xml:space="preserve">
    <value>Excel workbook</value>
    <comment>Save picker: the .xlsx file type.</comment>
  </data>
  <data name="SaveTypeCsv" xml:space="preserve">
    <value>CSV file</value>
    <comment>Save picker: the .csv file type.</comment>
  </data>
  <data name="FileProblem_Unknown" xml:space="preserve">
    <value>Something went wrong. The details below say what.</value>
    <comment>Error explanation: an error without a plain explanation.</comment>
  </data>
  <data name="FileProblem_NotFound" xml:space="preserve">
    <value>The file or its folder doesn't exist. It may have been moved, renamed or deleted.</value>
    <comment>Error explanation: the file or folder does not exist.</comment>
  </data>
  <data name="FileProblem_AccessDenied" xml:space="preserve">
    <value>Windows doesn't allow access to this file. Check that the file isn't read-only and that you have permission to use it.</value>
    <comment>Error explanation: no permission, or a read-only file.</comment>
  </data>
  <data name="FileProblem_ReadFailed" xml:space="preserve">
    <value>The file couldn't be read. Another program may be using it: close it there and try again.</value>
    <comment>Error explanation: the file could not be read (often locked by another program).</comment>
  </data>
  <data name="FileProblem_WriteFailed" xml:space="preserve">
    <value>The file couldn't be written. Another program may be using it, or the disk may be full. The file was not changed, and your changes are still open here.</value>
    <comment>Error explanation: the file could not be written.</comment>
  </data>
  <data name="FileProblem_NotAWorkbook" xml:space="preserve">
    <value>This file isn't an Excel workbook (.xlsx).</value>
    <comment>Error explanation: the file is not an .xlsx workbook.</comment>
  </data>
  <data name="FileProblem_LegacyOrEncrypted" xml:space="preserve">
    <value>This is an older Excel workbook (.xls) or a password-protected one. Open it in Excel and save it as an .xlsx workbook without a password.</value>
    <comment>Error explanation: an .xls or password-protected workbook.</comment>
  </data>
  <data name="FileProblem_Damaged" xml:space="preserve">
    <value>The workbook is damaged and can't be read.</value>
    <comment>Error explanation: a damaged workbook.</comment>
  </data>
  <data name="FileProblem_CsvEmpty" xml:space="preserve">
    <value>The file is empty: it has no header line.</value>
    <comment>Error explanation: an empty .csv file.</comment>
  </data>
  <data name="FileProblem_CsvUnsupportedEncoding" xml:space="preserve">
    <value>The file's text encoding isn't supported. Save it as UTF-8 and try again.</value>
    <comment>Error explanation: a .csv file in an unsupported text encoding.</comment>
  </data>
  <data name="FileProblem_CsvUnterminatedQuote" xml:space="preserve">
    <value>The file has a value in quotes that is never closed.</value>
    <comment>Error explanation: a .csv file with an unclosed quote.</comment>
  </data>
  <data name="FileProblem_SaveNotSupported" xml:space="preserve">
    <value>Spreadsheet Editor can't save this change to an .xlsx file yet. Nothing was written, and your changes are still open here.</value>
    <comment>Error explanation: the writer cannot save this change yet.</comment>
  </data>
  <data name="FileProblem_InvalidDocument" xml:space="preserve">
    <value>The spreadsheet can't be saved as it is: every sheet needs at least one entry, and sheet names must differ.</value>
    <comment>Error explanation: the document cannot be saved as it is.</comment>
  </data>
  <data name="FileProblem_SourceDamaged" xml:space="preserve">
    <value>The workbook this spreadsheet was opened from is damaged, so it can't be saved. Nothing was written.</value>
    <comment>Error explanation: the workbook the document came from cannot be read again to save it.</comment>
  </data>
</root>
