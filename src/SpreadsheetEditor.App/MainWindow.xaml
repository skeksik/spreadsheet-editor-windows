<Window
    x:Class="SpreadsheetEditor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Every string comes from Strings/<lang>/Resources.resw: x:Uid here, Services.Strings in code (the window and title bar titles). -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- The File menu grows with docs/roadmap.md (open, save, save as, recent files). -->
        <MenuBar Grid.Row="1">
            <MenuBarItem x:Uid="MainWindow_FileMenu">
                <MenuFlyoutItem x:Uid="MainWindow_ExitItem" Click="OnExitClick" />
            </MenuBarItem>
        </MenuBar>

        <!-- Shown while no spreadsheet is open. -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">
            <FontIcon HorizontalAlignment="Center" FontSize="48" Glyph="&#xE9F9;" />
            <TextBlock x:Uid="MainWindow_EmptyTitle" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Uid="MainWindow_EmptyHint"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
